# Copy to .env and fill in. Everything here is optional.

# LinkedIn credentials, used only by `login` to pre-fill the sign-in form.
# You can always sign in by hand instead and solve any 2FA/checkpoint
# yourself - that is the safer option, and the only one that still works if
# LinkedIn challenges the automated login.
LI_EMAIL=
LI_PASSWORD=

# Where runtime files live. Defaults are relative to the project root.
# NEVER commit state.json: it holds live session cookies.
# STATE_PATH=./state.json
# SEARCHES_PATH=./searches.json
# CRITERIA_DIR=./criteria
# JOBS_DB_PATH=./jobs.db

# Local LLM endpoint. Requires the LM Studio `lms` CLI on PATH.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3.8-27b
